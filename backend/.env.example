# Django Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=farm2door_db
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=noreply@farm2door.com

# SSLCommerz Payment Gateway
SSLCZ_STORE_ID=your_sslcommerz_store_id
SSLCZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCZ_IS_SANDBOX=True

# SSLCommerz Callback URLs
SSLCZ_SUCCESS_URL=http://localhost:8000/api/payments/sslcommerz/success/
SSLCZ_FAIL_URL=http://localhost:8000/api/payments/sslcommerz/fail/
SSLCZ_CANCEL_URL=http://localhost:8000/api/payments/sslcommerz/cancel/
SSLCZ_IPN_URL=http://localhost:8000/api/payments/sslcommerz/ipn/

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Platform Settings
PLATFORM_COMMISSION_RATE=5.0
DEFAULT_DELIVERY_FEE=50.00
TAX_RATE=5.0

# File Upload Settings
MAX_UPLOAD_SIZE=5242880
